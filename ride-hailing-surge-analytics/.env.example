# Copy to .env (never commit it).  Defaults below work with `docker compose` on localhost.
# --- MySQL ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=ridehail
MYSQL_USER=etl
MYSQL_PASSWORD=change_me_etl
# --- Synthetic Hyderabad data. 400000 trips gives the forecast enough signal (50000 is a quick demo: R2 ~0.3) ---
SEED_TRIP_LIMIT=400000
SEED_DAYS=30
SEED_DRIVER_COUNT=2000
SEED_RIDER_COUNT=8000
SEED_CANCEL_RATE=0.08
SEED_INVALID_RATE=0.01
FAKER_SEED=42
LOG_LEVEL=INFO
# --- Spark (runs on your host) ---
SPARK_DRIVER_MEMORY=2g
# --- Kafka (host-side clients use the EXTERNAL listeners) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:19092,localhost:19093,localhost:19094
# --- HBase Thrift ---
HBASE_THRIFT_HOST=localhost
HBASE_THRIFT_PORT=9090
# --- Surge engine ---
SURGE_SOURCE=kafka          # kafka | files (files = local test mode)
SURGE_STORE=hbase           # hbase | memory (memory = tests only)
BRONZE_FORMAT=parquet       # parquet (per-batch idempotent) | delta (needs delta-spark download)
TRIGGER_SECONDS=60
# --- AWS (Phase 5). Use `aws configure` or fill these. ---
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
GLUE_DATABASE=ridehail
GLUE_CRAWLER=ridehail_curated_crawler
ATHENA_OUTPUT=
# --- GenAI assistant ---
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3.5-flash-lite
# --- Airflow email ---
ALERT_EMAIL_TO=you@example.com
SMTP_HOST=localhost
SMTP_PORT=1025
# --- Payout assumption (no driver online-time source exists for historical trips) ---
ONLINE_HOURS_PER_DAY=10
