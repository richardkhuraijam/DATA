# Copy to .env and fill in. Never commit .env.

# --- MySQL (Phase 1) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=ridehail
MYSQL_USER=etl
MYSQL_PASSWORD=change_me_etl

# --- TLC download ---
# 1–2 months of HVFHV Parquet. Files are ~400–800 MB each.
TLC_MONTHS=2026-01,2026-02
TLC_BASE_URL=https://d37ci6vzurychx.cloudfront.net

# --- Seed sample size ---
# Full months do NOT belong in MySQL on a 16 GB laptop (tens of millions of rows).
# Keep full Parquet on disk for Kafka replay; seed a sample for Sqoop/Spark Core.
SEED_TRIP_LIMIT=50000
SEED_DRIVER_COUNT=2000
SEED_RIDER_COUNT=8000
SEED_CANCEL_RATE=0.08
SEED_INVALID_RATE=0.01
FAKER_SEED=42
LOG_LEVEL=INFO

# --- Spark memory caps (used by Compose batch profile) ---
SPARK_WORKER_MEMORY=1g
SPARK_WORKER_CORES=1
SPARK_DRIVER_MEMORY=1g
SPARK_MASTER_MEMORY=512m

# --- Kafka (Phase 3; host ports map to EXTERNAL listeners) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:19092,localhost:19093,localhost:19094

# --- AWS Free Tier (Phase 5; leave blank until needed) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
ATHENA_WORKGROUP=primary
GLUE_DATABASE=ridehail_curated

# --- Databricks Free Edition (Phase 5/7) ---
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=

# --- Airflow email alerts (Phase 6) ---
AIRFLOW_FERNET_KEY=
AIRFLOW_ADMIN_PASSWORD=admin
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Open-Meteo / CityBikes (Phase 3; no keys required) ---
OPEN_METEO_LAT=40.758
OPEN_METEO_LON=-73.9855
CITYBIKES_NETWORK=citi-bike-nyc
